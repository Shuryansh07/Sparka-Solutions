# Local development only. On Catalyst, set these as AppSail environment variables
# in the console (never commit real credentials).

PORT=9000
NODE_ENV=development

# memory = local JSON file in backend/.data (dev) | catalyst = Catalyst Data Store
STORE_DRIVER=memory
DRAFT_TTL_DAYS=30

# Required to call /api/admin/* endpoints (header: x-admin-key)
ADMIN_API_KEY=

# Zoho CRM Web-to-Lead form. Leave the two tokens blank to skip CRM locally
# (submissions are still stored). Copy them from the hidden xnQsjsdp / xmIwtLD inputs
# of the generated webform code.
ZOHO_WEBFORM_URL=https://crm.zoho.com/crm/WebToLeadForm
ZOHO_WEBFORM_XNQSJSDP=
ZOHO_WEBFORM_XMIWTLD=
ZOHO_WEBFORM_RETURN_URL=https://sparka-solution.onslate.com/
# Must match an existing value of the Lead Source picklist (used once Lead Source is on the webform)
ZOHO_LEAD_SOURCE=Website

# Product assistant (chat). Chat stays off until both OPENAI_API_KEY and CHAT_MODEL are set.
OPENAI_API_KEY=
# Required: an OpenAI model ID from your account's model list (no default on purpose)
CHAT_MODEL=
# Set to false to switch the assistant off without removing the key
CHAT_ENABLED=true
# Set to false only if your CHAT_MODEL rejects encrypted reasoning (non-reasoning models)
CHAT_ENCRYPTED_REASONING=true
