# Local development only. On Catalyst, set these as AppSail environment variables
# in the console (never commit real credentials).

PORT=9000
NODE_ENV=development

# Comma-separated list of allowed browser origins (your Slate URL in production)
CORS_ORIGINS=http://localhost:5173

# memory = local JSON file in backend/.data (dev) | catalyst = Catalyst Data Store
STORE_DRIVER=memory
DRAFT_TTL_DAYS=30

# Required to call /api/admin/* endpoints (header: x-admin-key)
ADMIN_API_KEY=

# Zoho CRM (leave blank to skip CRM sync locally; submissions are still stored)
# Data center: com | eu | in | com.au | jp | ca | sa
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional: CRM lead assignment rule that routes new leads to a representative
ZOHO_LEAD_ASSIGNMENT_RULE_ID=
# Must match an existing value of the Lead Source picklist in your CRM
ZOHO_LEAD_SOURCE=Website
ZOHO_TASK_DUE_DAYS=1

# Product assistant (chat). Chat stays off until both OPENAI_API_KEY and CHAT_MODEL are set.
OPENAI_API_KEY=
# Required: an OpenAI model ID from your account's model list (no default on purpose)
CHAT_MODEL=
# Set to false to switch the assistant off without removing the key
CHAT_ENABLED=true
